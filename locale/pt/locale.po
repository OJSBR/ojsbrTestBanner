msgid "plugins.generic.ojsbrTestBanner.displayName"
msgstr "Faixa de ambiente de testes"

msgid "plugins.generic.ojsbrTestBanner.description"
msgstr "Mostra uma faixa vermelha fixa em todas as páginas do portal, das revistas e da área de gestão editorial, assinalando a instalação como ambiente de testes. Configurada pelo administrador do site."

msgid "plugins.generic.ojsbrTestBanner.message"
msgstr "Ambiente de testes — os dados desta instalação não são oficiais"

msgid "plugins.generic.ojsbrTestBanner.settings.intro"
msgstr "A faixa aparece no fundo de todas as páginas desta instalação, exceto nos visualizadores de composição em página inteira (PDF, EPUB, HTML). Escreva a mensagem em cada idioma utilizado pelos leitores; quem lê num idioma sem mensagem vê a do idioma principal do site."

msgid "plugins.generic.ojsbrTestBanner.settings.message"
msgstr "Mensagem"

msgid "plugins.generic.ojsbrTestBanner.settings.message.description"
msgstr "Texto simples, até 200 caracteres. Deixe todos os idiomas em branco para utilizar a mensagem predefinida."

msgid "plugins.generic.ojsbrTestBanner.settings.message.tooLong"
msgstr "A mensagem deve ter, no máximo, 200 caracteres."

msgid "plugins.generic.ojsbrTestBanner.settings.default"
msgstr "Mensagem predefinida:"
