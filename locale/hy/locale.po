#, fuzzy
msgid "plugins.generic.ojsbrTestBanner.displayName"
msgstr "Փորձարկման միջավայրի գոտի"

#, fuzzy
msgid "plugins.generic.ojsbrTestBanner.description"
msgstr "Պորտալի, ամսագրերի և խմբագրական բաժնի բոլոր էջերում ցուցադրում է անշարժ կարմիր գոտի, որը նշում է, որ տեղադրումը փորձարկման միջավայր է։ Կարգավորում է կայքի ադմինիստրատորը։"

#, fuzzy
msgid "plugins.generic.ojsbrTestBanner.message"
msgstr "Փորձարկման միջավայր — այս տեղադրման տվյալները պաշտոնական չեն"

#, fuzzy
msgid "plugins.generic.ojsbrTestBanner.settings.intro"
msgstr "Գոտին երևում է այս տեղադրման բոլոր էջերի ներքևում, բացառությամբ ամբողջ էջով ֆայլերի դիտիչների (PDF, EPUB, HTML)։ Գրեք հաղորդագրությունը ընթերցողների օգտագործած յուրաքանչյուր լեզվով․ առանց հաղորդագրության լեզվով կարդացողը տեսնում է կայքի հիմնական լեզվի հաղորդագրությունը։"

#, fuzzy
msgid "plugins.generic.ojsbrTestBanner.settings.message"
msgstr "Հաղորդագրություն"

#, fuzzy
msgid "plugins.generic.ojsbrTestBanner.settings.message.description"
msgstr "Պարզ տեքստ, մինչև 200 նիշ։ Թողեք բոլոր լեզուները դատարկ՝ լռելյայն հաղորդագրությունն օգտագործելու համար։"

#, fuzzy
msgid "plugins.generic.ojsbrTestBanner.settings.message.tooLong"
msgstr "Հաղորդագրությունը պետք է լինի առավելագույնը 200 նիշ։"

#, fuzzy
