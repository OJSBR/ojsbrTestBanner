msgid "plugins.generic.ojsbrTestBanner.displayName"
msgstr "Bandeau d'environnement de test"

msgid "plugins.generic.ojsbrTestBanner.description"
msgstr "Affiche un bandeau rouge fixe sur toutes les pages du portail, des revues et de l'espace éditorial, indiquant que l'installation est un environnement de test. Configuré par l'administrateur ou l'administratrice du site."

msgid "plugins.generic.ojsbrTestBanner.message"
msgstr "Environnement de test — les données de cette installation ne sont pas officielles"

msgid "plugins.generic.ojsbrTestBanner.settings.intro"
msgstr "Le bandeau apparaît au bas de toutes les pages de cette installation, sauf dans les visionneuses d'épreuves en pleine page (PDF, EPUB, HTML). Rédigez le message dans chaque langue utilisée par vos lecteurs et lectrices; une personne dont la langue n'a pas de message voit celui de la langue principale du site."

msgid "plugins.generic.ojsbrTestBanner.settings.message"
msgstr "Message"

msgid "plugins.generic.ojsbrTestBanner.settings.message.description"
msgstr "Texte brut, 200 caractères au maximum. Laissez toutes les langues vides pour utiliser le message par défaut."

msgid "plugins.generic.ojsbrTestBanner.settings.message.tooLong"
msgstr "Le message doit comporter au maximum 200 caractères."

msgid "plugins.generic.ojsbrTestBanner.settings.default"
msgstr "Message par défaut :"
